# Copy to an untracked .env for local Compose development. These values match
# the disposable local services and must never be used as production secrets.
CONFIRMATION_SECRET=local-confirmation-secret-change-me-32-characters
ACTOR_ID=11111111-1111-4111-8111-111111111111
BRAND_ID=99999999-0000-4000-8000-000000000001
# Optional. Keep real credentials only in an untracked local .env file.
OPENAI_API_KEY=
OPENAI_COPILOT_MODEL=gpt-5.6-terra
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=quotation-uploads
S3_ACCESS_KEY_ID=minio_local
S3_SECRET_ACCESS_KEY=minio_local_change_me
VITE_API_PROXY_TARGET=http://api:3001
