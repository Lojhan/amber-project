# Host dependencies and build products are never part of a reproducible image.
node_modules/
**/node_modules/
.pnpm-store/
dist/
**/dist/
coverage/
**/coverage/
.turbo/
test-results/
playwright-report/
.codeql/

# Local state and credentials must not enter the image context.
.git/
.env
.env.*
!.env.example
*.log
.DS_Store

# Extracted/redundant local challenge artifacts are not application source.
coding-challenge/
